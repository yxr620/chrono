# 发布构建环境变量 — 密钥留空防止泄露到发布产物
# Production build env — secrets intentionally left empty to prevent leaking into release bundles
#
# Vite 在 `npm run build`（production mode）时自动加载此文件。
# 此文件的值会覆盖 .env.local，确保发布构建不含密钥。

# OSS 同步（发布版不内置密钥，用户可在应用内自行配置）
VITE_OSS_REGION=
VITE_OSS_BUCKET=
VITE_OSS_ACCESS_KEY_ID=
VITE_OSS_ACCESS_KEY_SECRET=

# AI 助手（发布版不内置 API Key）
VITE_AI_PROVIDER_ID=
VITE_AI_MODEL=
VITE_AI_BASE_URL=
VITE_AI_API_KEY=
