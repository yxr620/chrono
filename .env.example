# ─── Chrono Managed Services（推荐） / Recommended ─────────────────────
# Public URL of your Chrono backend (Aliyun FC). When set, the app
# offers Managed mode for sync + AI; users sign in with email/password.
# Leave empty to disable managed mode entirely.
#
# 配置 Chrono 后端（Aliyun FC）的公开 URL。设置后即可在「服务」页中开启
# 托管模式（同步 + AI），用户用邮箱密码登录。留空则只支持 BYO 模式。
VITE_AUTH_API_URL=

# ─── BYO Mode（可选 / legacy） ─────────────────────────────────────
# Only needed if you want users to skip Managed and use their own
# credentials. Most public deployments leave these blank.
# 仅当你希望用户跳过托管模式、自带凭据时才需要填写。

# Aliyun OSS（多端同步）/ Multi-device sync
VITE_OSS_REGION=oss-accelerate
VITE_OSS_BUCKET=your-bucket-name
VITE_OSS_ACCESS_KEY_ID=your-access-key-id
VITE_OSS_ACCESS_KEY_SECRET=your-access-key-secret

# AI 助手默认值（仅 BYO 模式生效；用户在设置里可覆盖并保存到 localStorage）
# AI Assistant defaults (BYO only — overridden by user's saved settings)
# Provider ID: qwen / gemini / glm / kimi / minimax / openai / custom
VITE_AI_PROVIDER_ID=qwen
VITE_AI_MODEL=qwen3.6-max-preview
VITE_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VITE_AI_API_KEY=

# 备注 / Notes:
# 1. 托管模式启用后，新用户 BYO 表单仍可见，二选一保存在 localStorage（chrono_feature_modes）
# 2. OSS AccessKey 获取：https://ram.console.aliyun.com/manage/ak
# 3. 建议使用 RAM 用户的 AccessKey，限制权限范围
# 4. CLI 调试脚本兼容不带 VITE_ 前缀的 AI_* 变量
